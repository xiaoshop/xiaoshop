{
  "name": "@xiaoshop/xiaoshop",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "author": "Allen Luo <luoyi@mouji.net>",
  "license": "MIT",
  "homepage": "https://github.com/xiaoshop/xiaoshop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoshop/xiaoshop.git"
  },
  "bugs": {
    "url": "https://github.com/xiaoshop/xiaoshop/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*",
    "services/*",
    "docs/*"
  ],
  "catalogs": {
    "build": {
      "@antfu/eslint-config": "^9.0.0",
      "@antfu/ni": "^30.1.0",
      "@commitlint/cli": "^21.0.2",
      "@commitlint/config-conventional": "^21.0.2",
      "@types/node": "^25.9.1",
      "@typescript/native-preview": "7.0.0-dev.20260603.1",
      "eslint": "^10.4.1",
      "eslint-plugin-format": "^2.0.1",
      "lint-staged": "^17.0.7",
      "simple-git-hooks": "^2.13.1",
      "taze": "^19.14.1",
      "turbo": "^2.9.16",
      "typescript": "^6.0.3"
    },
    "dev": {
      "@tailwindcss/vite": "^4.3.0",
      "@vitejs/plugin-vue-jsx": "^5.1.5",
      "@vitejs/plugin-vue": "^6.0.7",
      "@vue/devtools-api": "^8.1.2",
      "@vue/devtools-ui": "^8.1.2",
      "magic-string": "^0.30.21",
      "unplugin-auto-import": "^21.0.0",
      "unplugin-icons": "^23.0.1",
      "unplugin-vue-components": "^32.1.0",
      "unplugin-vue-define-options": "^3.1.2",
      "vite-plugin-vue-devtools": "^8.1.2",
      "vite-plugin-vue-layouts": "^0.11.0",
      "vite": "^8.0.16",
      "vue-tsc": "^3.3.3",
      "zod": "^4.4.3"
    },
    "frontend": {
      "@iconify-json/ri": "^1.2.10",
      "@iconify-json/solar": "^1.2.5",
      "@unhead/vue": "^3.1.3",
      "@vueuse/core": "^14.3.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "nprogress": "^0.2.0",
      "pinia": "^3.0.4",
      "reka-ui": "^2.9.9",
      "shadcn-vue": "^2.7.4",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.0",
      "tw-animate-css": "^1.4.0",
      "vue-router": "^5.1.0",
      "vue-sonner": "^2.0.9",
      "vue": "^3.5.35"
    },
    "testing": {
      "vitest": "^4.1.8"
    },
    "types": {
      "@types/node": "^25.9.1",
      "@types/nprogress": "^0.2.3"
    }
  },
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "dev:admin": "turbo run dev --filter=@xiaoshop/admin",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "taze": "taze major -frI",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules services/*/node_modules docs/node_modules"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:build",
    "@antfu/ni": "catalog:build",
    "@commitlint/cli": "catalog:build",
    "@commitlint/config-conventional": "catalog:build",
    "@types/node": "catalog:types",
    "@typescript/native-preview": "catalog:build",
    "eslint": "catalog:build",
    "eslint-plugin-format": "catalog:build",
    "lint-staged": "catalog:build",
    "simple-git-hooks": "catalog:build",
    "taze": "catalog:build",
    "turbo": "catalog:build",
    "typescript": "catalog:build"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged",
    "commit-msg": "bun commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
